 *
 * 旧Vialキーマップ(20260726__CronixKeymap.vil / Vialスクリーンショットで確認済み)からの復元版
 * ベース: hitsmaxft/zmk-keyboard-cornix v2.7.1 の config/cornix.keymap
 * ホームロー修飾(hm_l/hm_r)は使用せず、Vial時代の「固定位置の修飾キー」方式に変更
 */

#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define LOWER  1
#define ADJUST 2

/ {
    macros {
        // Vial M3: Win + Shift + S  (Windows スクリーンショット)
        zm_screenshot: zm_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp S>
                      , <&macro_release &kp LGUI &kp LSHFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // 左上段: Tab Q W E R T                    | 右上段: Y U I O P Bksp
            // 左中段: LCtrl A S D F G  (中央:Ctrl+0)    | 右中段: (中央:M2) H J K L \ Enter
            // 左下段: LShift Z X C V B (中央:Mute)      | 右下段: (中央:Mute) N M , . Up /
            // 左下+親指: CapsLock LGui LAlt | LT1 Mouse1 Mouse2  右下+親指: Right Down Left | LT2 Space Space

            bindings = <
&kp TAB      &kp Q    &kp W    &kp E                  &kp R    &kp T                              &kp Y     &kp U    &kp I    &kp O                 &kp P      &kp BACKSPACE
&kp LCTRL    &kp A    &kp S    &kp D                  &kp F    &kp G           &kp LC(N0)          &kp H     &kp J    &kp K    &kp L                 &kp BSLH   &kp ENTER
&kp LSHFT    &kp Z    &kp X    &kp C                  &kp V    &kp B           &kp C_MUTE          &kp N     &kp M    &kp COMMA &kp DOT              &kp UP     &kp FSLH
&kp CAPSLOCK &kp LGUI &kp LALT &lt LOWER LANG2         &mkp MB1 &mkp MB2                            &kp RIGHT &kp DOWN &kp LEFT &lt ADJUST LANG1      &kp SPACE  &kp SPACE
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp LC(KP_PLUS) LC(KP_MINUS)>;
        };

        lower_layer {
            display-name = "Lower";

            // 左上段: Esc 1 2 3 4 5                | 右上段: Del 0 9 8 7 6
            // 左中段: - MouseUp Win+Shift+S - ; -  (中央:右クリック) | 右中段: (中央:右クリック) - - - - ' =
            // 左下段: - MouseDown - - - -  (中央:Mute) | 右下段: (中央:Mute) - - - - -
            // 左下+親指: 全てtrans                 | 右下+親指: 全てtrans

            bindings = <
&kp ESCAPE &kp N1         &kp N2         &kp N3 &kp N4  &kp N5                          &kp DEL &kp N0  &kp N9  &kp N8  &kp N7  &kp N6
&trans     &mmv MOVE_UP   &zm_screenshot &trans &kp SEMI &kp MINUS   &mkp MB3            &trans  &trans  &trans  &trans  &kp SQT &kp EQUAL
&trans     &mmv MOVE_DOWN &trans         &trans &trans  &trans      &kp C_MUTE          &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans         &trans         &trans &trans  &trans                          &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &msc SCRL_UP &msc SCRL_DOWN>;
        };

        adjust_layer {
            display-name = "Adjust";

            // Vial画面で BT2 / BT1 / BT0 と表示されていたBluetoothデバイス切り替え(確定)
            // 左中段の左端=BT2、左下段の左端=BT1、左下+親指列の左端=BT0

            bindings = <
&none  &none  &none  &none  &none  &none                        &none  &none  &none  &none  &none  &none
&bt BT_SEL 2 &none &none &none &none &none        &mkp MB3       &none  &none  &none  &none  &none  &none
&bt BT_SEL 1 &none &none &none &none &none        &kp C_MUTE     &none  &none  &none  &none  &none  &none
&bt BT_SEL 0 &none &none &trans &none &none                       &none  &none  &none  &trans &none  &none
            >;
        };
    };
};
