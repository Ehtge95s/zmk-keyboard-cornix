/*
 * Cornix LP keymap converted from:
 *   20260726_ CronixKeymap(1).vil
 * Target repository/branch:
 *   Ehtge95s/zmk-keyboard-cornix / cornix-v2.7.1
 *
 * Layer 0: Base
 * Layer 1: Numbers / mouse
 * Layer 2: Bluetooth
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUM_MOUSE 1
#define BLUETOOTH 2

/ {
    behaviors {
        /*
         * Tap: LANG1/LANG2
         * Hold: momentarily activate the selected layer
         * Matches the original Vial LT1/LT2 usage.
         */

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
        };

        /*
         * Rotary encoder mouse scrolling.
         * First parameter = clockwise, second = counter-clockwise.
         */

        rot_msc: sensor_rotate_mouse_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
    };

    macros {
        mc_00: mc_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "MC_00";
        };

        mc_NumMode: mc_NumMode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 2 &kp LANG2>;
            label = "MC_NUMMODE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB     &kp Q     &kp W     &kp E                &kp R     &kp T                              &kp Y      &kp U      &kp I                &kp O     &kp P     &kp BSPC
&kp LCTRL   &kp A     &kp S     &kp D                &kp F     &kp G                              &kp H      &kp J      &kp K                &kp L     &kp BSLH  &kp ENTER
&kp LSHIFT  &kp Z     &kp X     &kp C                &kp V     &kp B     &kp C_MUTE  &mc_NumMode  &kp N      &kp M      &kp COMMA            &kp DOT   &kp UP    &kp FSLH
&kp RCTRL   &kp LGUI  &kp LALT  &lt NUM_MOUSE LANG2  &mkp MB1  &mkp MB2                           &kp SPACE  &kp SPACE  &lt BLUETOOTH LANG1  &kp LEFT  &kp DOWN  &kp RIGHT
            >;

            /*
             * Left encoder:  CW Volume Up / CCW Volume Down
             * Right encoder: CW Ctrl+KP- / CCW Ctrl+KP+
             * (preserves the order stored in the Vial file)
             */

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp LC(KP_MINUS) LC(KP_PLUS)
            >;
        };

        number_mouse_layer {
            display-name = "NumberMouse";
            bindings = <
&kp ESC           &kp N1  &kp N2         &kp N3  &kp N4      &kp N5                                &kp N6     &kp N7   &kp N8  &kp N9  &kp N0  &kp DEL
&kp LEFT_CONTROL  &none   &kp LG(LS(S))  &none   &kp SEMI    &kp MINUS                             &kp EQUAL  &kp SQT  &none   &none   &none   &none
&kp LSHIFT        &none   &none          &none   &none       &none           &kp C_MUTE  &mkp MB3  &none      &none    &none   &none   &none   &none
&kp CAPSLOCK      &none   &none          &none   &bt BT_CLR  &bt BT_CLR_ALL                        &none      &none    &none   &none   &none   &none
            >;

            /* Left: volume. Right: mouse wheel down/up. */

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &rot_msc SCRL_DOWN SCRL_UP
            >;
        };

        bluetooth_layer {
            display-name = "Bluetooth";
            bindings = <
&kp ESC       &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LSHIFT  &kp UP     &kp TAB                       &kp UNDER    &kp SLASH     &kp MINUS      &kp N7  &kp N8  &kp N9
&bt BT_SEL 2  &kp LC(A)         &kp LC(S)     &kp LEFT    &kp DOWN   &kp RIGHT                     &kp COMMA    &kp ASTERISK  &kp PLUS       &kp N4  &kp N5  &kp N6
&bt BT_SEL 1  &kp LC(Z)         &kp LC(X)     &kp LC(C)   &kp LC(V)  &kp LC(Y)  &to 0  &kp K_CALC  &kp INT_YEN  &kp PERCENT   &kp EQUAL      &kp N1  &kp N2  &kp N3
&bt BT_SEL 0  &bt BT_SEL 3      &bt BT_SEL 4  &mo 1       &mkp MB1   &mkp MB2                      &kp SPACE    &kp ENTER     &kp BACKSPACE  &kp N0  &mc_00  &kp DOT
            >;

            /* Left: volume. Right: mouse wheel down/up. */

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &rot_msc SCRL_DOWN SCRL_UP
            >;
        };
    };
};
